---
const services = [
  {
    title: "Landing Pages",
    description: "Sitios web modernos y optimizados para convertir visitantes en clientes.",
    icon: "→",
  },
  {
    title: "Desarrollo Web",
    description: "Aplicaciones web completas con tecnologías de punta como Astro, React y Node.js.",
    icon: "→",
  },
  {
    title: "Consultoría Tech",
    description: "Asesoramiento técnico para elegir las mejores herramientas y arquitecturas.",
    icon: "→",
  },
];
---

<section id="services" class="bg-black px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-4 text-center text-sm font-medium uppercase tracking-widest text-emerald-400">Servicios</h2>
    <h3 class="mb-16 text-center text-3xl font-bold text-white md:text-4xl">Lo que hacemos</h3>
    <div class="grid gap-8 md:grid-cols-3">
      {
        services.map((service) => (
          <div class="group rounded-xl border border-zinc-800 bg-zinc-900/50 p-8 transition-colors hover:border-emerald-800/50">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-400">
              <span class="text-xl">{service.icon}</span>
            </div>
            <h4 class="mb-3 text-xl font-semibold text-white">{service.title}</h4>
            <p class="text-zinc-400">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
