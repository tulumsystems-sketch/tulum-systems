---

---

<section id="contacto" class="px-6 py-24 md:py-32">
  <div class="section-divider mb-16 w-full"></div>

  <div class="mx-auto max-w-7xl">
    <div class="grid gap-16 md:grid-cols-2 md:gap-20 lg:gap-28">
      <div data-reveal="section">
        <p class="mb-4 text-xs font-medium tracking-[0.25em] text-gold uppercase">
          Contacto
        </p>
        <h2
          data-reveal="word"
          class="mb-8 font-serif text-4xl font-normal leading-[1.1] tracking-tight text-warm sm:text-5xl md:text-6xl lg:text-7xl"
        >
          Construyamos
          <br />
          algo juntos.
        </h2>
        <p class="max-w-md text-lg leading-relaxed text-muted md:text-xl">
          Contanos sobre tu proyecto y te respondemos a la brevedad.
        </p>
      </div>

      <div data-reveal="fade">
        <form class="space-y-8" netlify>
          <div>
            <label for="nombre" class="mb-3 block text-xs font-medium tracking-[0.2em] text-subtle uppercase">
              Nombre
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              class="w-full border-b border-border bg-transparent py-4 text-lg text-warm outline-none transition-all duration-300 placeholder:text-subtle/30 focus:border-gold"
              placeholder="Tu nombre"
            />
          </div>
          <div>
            <label for="email" class="mb-3 block text-xs font-medium tracking-[0.2em] text-subtle uppercase">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full border-b border-border bg-transparent py-4 text-lg text-warm outline-none transition-all duration-300 placeholder:text-subtle/30 focus:border-gold"
              placeholder="tu@email.com"
            />
          </div>
          <div>
            <label for="mensaje" class="mb-3 block text-xs font-medium tracking-[0.2em] text-subtle uppercase">
              Mensaje
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="4"
              required
              class="w-full resize-none border-b border-border bg-transparent py-4 text-lg text-warm outline-none transition-all duration-300 placeholder:text-subtle/30 focus:border-gold"
              placeholder="Contanos sobre tu proyecto..."
            ></textarea>
          </div>
          <div class="pt-4">
            <button
              type="submit"
              class="group inline-flex items-center gap-3 border-b border-gold/30 pb-1 text-lg font-light text-gold transition-all duration-500 hover:border-gold/70"
            >
              Enviar mensaje
              <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
            </button>
          </div>
        </form>

        <div class="mt-12 pt-8 border-t border-border/50">
          <p class="text-sm text-subtle">
            O escribinos directamente a
            <a href="mailto:tulumsystems@gmail.com" class="text-warm underline decoration-border underline-offset-4 transition-colors hover:text-gold hover:decoration-gold/40">
              tulumsystems@gmail.com
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
