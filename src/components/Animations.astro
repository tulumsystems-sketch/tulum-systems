<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function init() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const mm = gsap.matchMedia();

    // --- Smooth anchor scroll ---
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", (e) => {
        const href = anchor.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          const top = target.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top, behavior: "smooth" });
        }
      });
    });

    // --- Navbar scroll effect ---
    const nav = document.getElementById("navbar");
    if (nav) {
      ScrollTrigger.create({
        start: "top -80px",
        onUpdate: (self) => {
          nav.classList.toggle("scrolled", self.progress > 0);
        },
      });
    }

    // --- Parallax (desktop only) ---
    mm.add("(min-width: 768px)", () => {
      document.querySelectorAll("[data-parallax-speed]").forEach((el) => {
        const speed = parseFloat(el.getAttribute("data-parallax-speed")) || 0;
        const container = el.closest("[data-parallax-container]") || el.parentElement;
        gsap.to(el, {
          y: () => window.innerHeight * speed * 0.5,
          ease: "none",
          scrollTrigger: {
            trigger: container,
            start: "top bottom",
            end: "bottom top",
            scrub: 2,
          },
        });
      });
    });

    // --- Enhanced fade reveal ---
    document.querySelectorAll("[data-reveal='fade']").forEach((el) => {
      gsap.from(el, {
        y: 50,
        opacity: 0,
        duration: 1.2,
        ease: "power4.out",
        scrollTrigger: { trigger: el, start: "top 82%" },
      });
    });

    // --- Enhanced word reveal ---
    document.querySelectorAll("[data-reveal='word']").forEach((el) => {
      const text = el.textContent.trim();
      const words = text.split(/\s+/);
      el.innerHTML = words
        .map(
          (word) =>
            `<span class="word-reveal"><span>${word}</span></span>`,
        )
        .join(" ");

      const spans = el.querySelectorAll(".word-reveal > span");
      gsap.fromTo(
        spans,
        { y: "100%", opacity: 0, rotateX: -15 },
        {
          y: "0%",
          opacity: 1,
          rotateX: 0,
          duration: 0.9,
          stagger: 0.04,
          ease: "power4.out",
          scrollTrigger: { trigger: el, start: "top 75%" },
        },
      );
    });

    // --- Section reveal ---
    document.querySelectorAll("[data-reveal='section']").forEach((section) => {
      const animated = section.querySelectorAll("[data-reveal='word'], [data-reveal='fade']");
      if (animated.length === 0) {
        gsap.from(section.children, {
          y: 40,
          opacity: 0,
          duration: 1,
          stagger: 0.15,
          ease: "power4.out",
          scrollTrigger: { trigger: section, start: "top 80%" },
        });
      }
    });

    // --- Enhanced stagger reveal ---
    document.querySelectorAll("[data-reveal='stagger']").forEach((container) => {
      const items = container.querySelectorAll(".stagger-item");
      if (items.length > 0) {
        gsap.to(items, {
          y: 0,
          opacity: 1,
          duration: 1,
          stagger: 0.2,
          ease: "power4.out",
          scrollTrigger: { trigger: container, start: "top 75%" },
        });
      } else {
        gsap.from(container.children, {
          y: 50,
          opacity: 0,
          duration: 1,
          stagger: 0.15,
          ease: "power4.out",
          scrollTrigger: { trigger: container, start: "top 75%" },
        });
      }
    });

    // --- Hero entrance: TULUM + systems ---
    const heroTitle = document.getElementById("hero-title");
    if (heroTitle) {
      gsap.fromTo(
        heroTitle,
        { y: 80, opacity: 0, scale: 0.96 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 2.2,
          ease: "power3.out",
          delay: 0.4,
        },
      );
      const subtitle = heroTitle.nextElementSibling;
      if (subtitle) {
        gsap.fromTo(
          subtitle,
          { y: 20, opacity: 0 },
          { y: 0, opacity: 1, duration: 1.2, ease: "power3.out", delay: 1.4 },
        );
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
