---

<section
  id="paisaje"
  class="relative min-h-[120vh] w-full overflow-hidden bg-[#1a2a38]"
>
  <div class="absolute inset-0 bg-[#1a2a38]">
    <img
      src="/Fotopiemontaña.jpg"
      alt="Precordillera de San Juan, Argentina"
      class="h-full w-full object-cover opacity-80"
    />
  </div>

  <div class="absolute inset-0 z-10 flex items-center justify-center px-6">
    <div class="mx-auto max-w-5xl text-center">
      <p
        data-reveal="word"
        class="font-serif text-4xl font-normal leading-[1.2] tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl"
      >
        Nacidos al pie de la Cordillera.
        <br />
        Diseñados para durar.
      </p>
    </div>
  </div>
</section>
