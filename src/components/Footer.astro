---

const year = new Date().getFullYear();
---

<footer class="bg-gradient-to-b from-[#1a2a3a] to-[#0f1a24] px-6 py-16 md:py-24">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-12 md:flex-row md:items-end">
    <div>
      <a href="/" class="flex items-center" aria-label="Tulum Systems — inicio">
        <img
          src="/Logo-responsive.png"
          alt="Tulum Systems"
          class="h-10 w-auto object-contain md:h-12"
        />
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/40">
        Productos de software desde la Cordillera de los Andes.
      </p>
    </div>

    <div class="flex flex-col items-start gap-6 md:items-end">
      <nav aria-label="Enlaces del footer">
        <ul class="flex gap-8">
          <li>
            <a href="#manifiesto" class="text-sm text-white/50 transition-colors hover:text-white">
              Manifiesto
            </a>
          </li>
          <li>
            <a href="#productos" class="text-sm text-white/50 transition-colors hover:text-white">
              Productos
            </a>
          </li>
          <li>
            <a href="#contacto" class="text-sm text-white/50 transition-colors hover:text-white">
              Contacto
            </a>
          </li>
        </ul>
      </nav>
      <p class="text-xs text-white/30">&copy; {year} Tulum Systems. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
