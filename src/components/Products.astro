---
interface Product {
  name: string;
  description: string;
  status: string;
}

const products: Product[] = [
  {
    name: "Tulum Medical",
    description: "Software para profesionales de la salud.",
    status: "Desarrollo activo",
  },
  {
    name: "Tulum Core",
    description: "Infraestructura para construir productos escalables.",
    status: "Arquitectura inicial",
  },
];
---

<section id="productos" class="px-6 py-24 md:py-32">
  <div class="section-divider mb-16 w-full"></div>

  <div class="mx-auto max-w-7xl">
    <div data-reveal="section">
      <p class="mb-4 text-xs font-medium tracking-[0.25em] text-gold uppercase">
        Productos
      </p>
      <h2
        data-reveal="word"
        class="mb-16 max-w-3xl font-serif text-4xl font-normal leading-[1.15] tracking-tight text-warm sm:text-5xl md:text-6xl"
      >
        Construimos productos que resuelven problemas reales.
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2" data-reveal="stagger">
      {products.map((product, i) => (
        <article
          class="stagger-item group relative overflow-hidden rounded-2xl border border-gold/15 bg-gradient-to-br from-gold/[0.04] to-transparent p-8 opacity-0 transition-all duration-700 hover:border-gold/30 hover:from-gold/[0.07] md:p-10 lg:p-12"
        >
          <div class="absolute right-0 top-0 h-32 w-32 translate-x-8 -translate-y-8 rounded-full bg-gold/[0.03] blur-3xl"></div>

          <div class="relative">
            <div class="mb-6 flex items-center gap-4">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-gold/10 text-xs font-semibold tracking-wide text-gold"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="h-px flex-1 bg-gold/10"></div>
              <span
                class="inline-block rounded-full border border-gold/20 px-3 py-1 text-[10px] font-medium tracking-wider text-gold uppercase"
              >
                {product.status}
              </span>
            </div>

            <h3
              class="mb-4 font-serif text-3xl font-normal leading-tight text-warm transition-colors duration-500 group-hover:text-gold sm:text-4xl md:text-5xl"
            >
              {product.name}
            </h3>

            <p class="max-w-md text-lg leading-relaxed text-warm/80 md:text-xl">
              {product.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
