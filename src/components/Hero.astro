---

---

<section id="hero" class="relative h-screen w-full overflow-hidden">
  <div class="absolute inset-0 h-full w-full">
    <img
      src="/CordilleNevada.jpg"
      alt=""
      class="h-full w-full object-cover"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#1a2a38]/80 via-[#1a2a38]/60 to-[#f7f6f2]/90"></div>
  </div>

  <div
    class="relative z-10 mx-auto flex h-full max-w-7xl flex-col items-center justify-center px-6 text-center"
  >
    <p
      data-reveal="fade"
      class="mb-8 text-xs font-medium tracking-[0.3em] text-gold-muted uppercase"
    >
      Desde la Cordillera de los Andes
    </p>

    <div id="hero-title" class="mb-6">
      <h1
        class="font-sans text-7xl font-black leading-none tracking-tight text-white sm:text-8xl md:text-9xl lg:text-[10rem] xl:text-[12rem]"
      >
        TULUM
      </h1>
      <p class="mt-2 text-base font-light tracking-[0.35em] text-white/70 md:text-lg uppercase">
        systems
      </p>
    </div>

    <p
      data-reveal="fade"
      class="text-base font-light tracking-wide text-white/60 md:text-lg"
    >
      Construimos productos de software.
    </p>

    <div data-reveal="fade" class="mt-16">
      <a
        href="#productos"
        class="group relative inline-flex items-center gap-2 bg-[#4a6f8a] px-10 py-4 text-sm font-medium tracking-widest text-white transition-all duration-500 hover:bg-[#3a5a75] uppercase"
      >
        Explorar
        <span class="inline-block transition-transform duration-500 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>


</section>
