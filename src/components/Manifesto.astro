---

---

<section
  id="manifiesto"
  class="flex min-h-screen flex-col items-center justify-center px-6 py-24"
>
  <div class="section-divider mb-24 w-full"></div>

  <div class="mx-auto w-full max-w-6xl">
    <div data-reveal="section">
      <p
        class="mb-16 text-xs font-medium tracking-[0.25em] text-gold uppercase"
      >
        Manifiesto
      </p>

      <div class="relative max-w-5xl">
        <div
          class="absolute -left-8 top-0 h-full w-px bg-gradient-to-b from-gold/30 via-gold/10 to-transparent"
        ></div>

        <p
          data-reveal="word"
          class="font-serif text-4xl font-normal leading-[1.15] tracking-tight text-warm sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl"
        >
          No construimos software para impresionar.
          <br />
          <span class="italic text-gold">Construimos software</span>
          <br />
          para resolver problemas reales.
        </p>
      </div>
    </div>
  </div>
</section>
