---
interface Step {
  number: string;
  title: string;
}

const steps: Step[] = [
  { number: "01", title: "Pensamos" },
  { number: "02", title: "Diseñamos" },
  { number: "03", title: "Construimos" },
  { number: "04", title: "Escalamos" },
];
---

<section
  id="proceso"
  class="bg-gradient-to-b from-[#2a4a6a] to-[#1a2a3a] px-6 py-24 md:py-32"
>
  <div class="section-divider mb-16 w-full !bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>

  <div class="mx-auto max-w-7xl">
    <div data-reveal="section">
      <p class="mb-4 text-xs font-medium tracking-[0.25em] text-white/50 uppercase">
        Proceso
      </p>
      <h2 data-reveal="word" class="mb-20 max-w-2xl font-serif text-4xl font-normal leading-[1.15] tracking-tight text-white sm:text-5xl md:mb-28 md:text-6xl">
        Cómo convertimos ideas en productos.
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2 md:gap-6" data-reveal="stagger">
      {steps.map((step) => (
        <div class="stagger-item group flex items-center gap-6 rounded-2xl border border-white/10 bg-white/[0.03] p-6 opacity-0 backdrop-blur-sm transition-all duration-500 hover:border-white/20 hover:bg-white/[0.06] hover:shadow-lg md:p-8">
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] font-serif text-2xl font-normal text-white/80 transition-all duration-500 group-hover:border-white/30 group-hover:bg-white/[0.08] md:h-16 md:w-16 md:text-3xl">
            {step.number}
          </span>
          <span class="text-xl font-light leading-tight tracking-tight text-white/90 transition-all duration-500 group-hover:tracking-wider md:text-2xl lg:text-3xl">
            {step.title}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
